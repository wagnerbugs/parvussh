[Desktop Entry]
Type=Application
Version=1.5
Name=ParvuSsh
# freedesktop convention: the unsuffixed value is English, and each
# translation gets its own [locale] key.
Comment=Manage your SSH connections by reading and writing the real ~/.ssh/config
Comment[pt_BR]=Gerencie suas conexões SSH lendo e escrevendo o ~/.ssh/config de verdade
Keywords=ssh;connection;server;vps;key;terminal;remote;config;
Keywords[pt_BR]=ssh;conexão;conexao;servidor;vps;chave;terminal;remoto;config;
Exec=parvussh
Icon=io.github.wagnerbugs.ParvuSsh
Terminal=false
Categories=Network;RemoteAccess;
StartupNotify=true
# Must match the application id, or the shell shows a generic icon on Wayland.
StartupWMClass=io.github.wagnerbugs.ParvuSsh
