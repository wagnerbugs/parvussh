[Desktop Entry]
Type=Application
Version=1.5
Name=ParvuSsh
Comment=Gerencie suas conexões SSH lendo e escrevendo o ~/.ssh/config de verdade
Keywords=ssh;conexão;conexao;servidor;vps;chave;terminal;remoto;config;
Exec=parvussh
Icon=io.github.wagnerbugs.ParvuSsh
Terminal=false
Categories=Network;RemoteAccess;
StartupNotify=true
# Must match the application id, or the shell shows a generic icon on Wayland.
StartupWMClass=io.github.wagnerbugs.ParvuSsh
